# --- Onus deployment credentials (Testnet Bradbury) ---
# Private key of a FUNDED Bradbury account used to deploy and configure contracts.
# Fund it first at https://testnet-faucet.genlayer.foundation (claim once / 24h).
# NEVER commit the real .env file. This .example file is the only one tracked in git.
ACCOUNT_PRIVATE_KEY=

# --- Protocol configuration ---
# Protocol fee applied to each pact's stake at resolution, in basis points (200 = 2%).
ONUS_FEE_BPS=200
